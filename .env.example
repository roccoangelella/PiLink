# Copying this file is optional: `pilink init` creates a private configuration.
PI_WORK_DIR=/absolute/path/to/your/workspace
PI_DATA_DIR=/absolute/path/to/private/pilink-state
PORT=3200
HOST=127.0.0.1
# Set by the interactive first launch. `nip-io` exposes this machine directly through Caddy.
# PI_HOSTING_MODE=quick-tunnel
# PI_NIP_IO_HOSTNAME=pilink-203-0-113-10.nip.io
# PI_CADDY_PATH=/path/to/caddy
# Use values generated by `pilink init`; never commit them.
JWT_SECRET=
PI_BOOTSTRAP_SECRET=
PI_MAX_BASH_TIMEOUT=120
# Set only with a fully trusted client. It enables unrestricted shell and filesystem access.
PI_UNSAFE_FULL_ACCESS=false
# Browser CORS is disabled by default. Comma-separate exact origins when needed.
CORS_ORIGINS=
