# Copying this file is optional: `pilink init` creates a private configuration.
PI_WORK_DIR=/absolute/path/to/your/workspace
# Core runtime mode. Choose `single` for the classic one-agent harness or
# `collaboration` for public chat, tasks, memory, work-loop, and supervised
# child-agent orchestration. `vscode` is a launch surface, not an env value.
PI_RUNTIME_MODE=collaboration
PI_DATA_DIR=/absolute/path/to/private/pilink-state
# Durable collaboration/audit state must be outside PI_WORK_DIR. The graphical
# wizard selects a private per-user runtime path automatically.
PI_COORDINATION_DATA_DIR=/absolute/path/outside/the/workspace/vspilink-coordination
PORT=3200
HOST=127.0.0.1
# Set by the graphical wizard or legacy interactive launch.
# PI_HOSTING_MODE=quick-tunnel
# Persistent Cloudflare example: PI_HOSTING_MODE=cloudflare-named
# SERVER_URL=https://mcp.example.com
# PI_LANDING_HOSTNAME=vspilink.example.com
# `nip-io` exposes this machine directly through Caddy.
# PI_NIP_IO_NETWORK=auto
# PI_NIP_IO_HOSTNAME=pilink-203-0-113-10.nip.io
# Optional override when automatic public-IPv4 detection cannot reach an IP service.
# PI_PUBLIC_IPV4=203.0.113.10
# PI_CADDY_PATH=/path/to/caddy
# Custom binary mirrors are permitted only with a matching SHA-256 digest.
# PI_CLOUDFLARED_URL=https://mirror.example/cloudflared
# PI_CLOUDFLARED_SHA256=64-lowercase-hex-characters
# PI_CADDY_URL=https://mirror.example/caddy.tar.gz
# PI_CADDY_SHA256=64-lowercase-hex-characters
# Use values generated by `pilink init`; never commit them.
JWT_SECRET=
PI_BOOTSTRAP_SECRET=
# Access tokens are short-lived; rotating refresh tokens keep MCP clients connected.
TOKEN_EXPIRY=3600
PI_REFRESH_TOKEN_EXPIRY=2592000
# `paired` requires a one-time owner pairing from the local VS Code extension.
# `browser` preserves the legacy standalone consent-page login.
PI_OAUTH_CONSENT_MODE=paired
# Allow tightly restricted, PKCE-only Dynamic Client Registration for ChatGPT.
PI_OAUTH_PUBLIC_CHATGPT_DCR=false
# Browser opening policy for the standalone CLI: auto, always, or never.
# `auto` opens only from an interactive terminal; tests and piped commands stay silent.
# PI_BROWSER_OPEN=auto
# Optional autonomous child-agent runtime. Configure provider and model together.
PI_AGENT_MAX_CONCURRENT=4
PI_AGENT_THINKING_LEVEL=medium
# PI_AGENT_PROVIDER=provider-id
# PI_AGENT_MODEL=model-id
# PI_AGENT_API_KEY=
PI_MAX_BASH_TIMEOUT=120
# Bound MCP transport state. Active requests and open streams are never reclaimed.
PI_MAX_MCP_SESSIONS_TOTAL=64
PI_MAX_MCP_SESSIONS_PER_CLIENT=16
# Close quiescent sessions after ten minutes. The grace protects only unfinished handshakes;
# established quiescent sessions can be recycled immediately when a quota is full.
PI_MCP_SESSION_IDLE_TIMEOUT=600
PI_MCP_SESSION_RECLAIM_GRACE=5
# Optional transport-continuity bridge for clients that open a fresh MCP session per tool call.
# The configured header must be injected by a trusted client/proxy, remain hidden from the model,
# and carry a different stable value for every logical conversation. The trusted edge must strip any
# inbound copy and overwrite it; merely accepting a caller-supplied header does not make it trusted.
# Never use a static shared value.
# PI_COLLABORATION_BINDING_HEADER=X-PiLink-Logical-Session
# Keep the private logical session alive across short-lived transports for ten minutes.
PI_COLLABORATION_BINDING_DETACH_GRACE=600
# Enables npm_build and npm_test in the constrained run tool. Workspace scripts
# are arbitrary code, so enable this only for a trusted workspace.
PI_ALLOW_WORKSPACE_EXECUTION=false
# Require supported MCP clients to show an explicit form approval before bash
# or trusted workspace-code profiles. Unsupported clients fail closed.
PI_REQUIRE_EXECUTION_APPROVAL=false
# Set only with a fully trusted client. Full access remains disabled for every
# OAuth client not named explicitly in PI_FULL_ACCESS_CLIENT_IDS.
PI_UNSAFE_FULL_ACCESS=false
# PI_FULL_ACCESS_CLIENT_IDS=pi_0123456789abcdef
# Browser CORS is disabled by default. Comma-separate exact origins when needed.
CORS_ORIGINS=
