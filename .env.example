# Copying this file is optional: `pilink init` creates a private configuration.
PI_WORK_DIR=/absolute/path/to/your/workspace
PI_DATA_DIR=/absolute/path/to/private/pilink-state
PORT=3200
HOST=127.0.0.1
# Set by the interactive first launch. `nip-io` exposes this machine directly through Caddy.
# PI_HOSTING_MODE=quick-tunnel
# PI_NIP_IO_NETWORK=auto
# PI_NIP_IO_HOSTNAME=pilink-203-0-113-10.nip.io
# Optional override when automatic public-IPv4 detection cannot reach an IP service.
# PI_PUBLIC_IPV4=203.0.113.10
# PI_CADDY_PATH=/path/to/caddy
# Use values generated by `pilink init`; never commit them.
JWT_SECRET=
PI_BOOTSTRAP_SECRET=
# Access-token lifetime in seconds. Default: 30 days.
TOKEN_EXPIRY=2592000
PI_MAX_BASH_TIMEOUT=120
# Enables npm_build and npm_test in the constrained run tool. Workspace scripts are arbitrary code,
# so use this only for a trusted workspace. PiLink secrets are not inherited by these child processes.
PI_ALLOW_WORKSPACE_EXECUTION=false
# Require an MCP form-elicitation approval before unrestricted bash or npm_build/npm_test.
# Unsupported clients and declined/cancelled approvals fail closed.
PI_REQUIRE_EXECUTION_APPROVAL=false
# Set only with a fully trusted client. It enables unrestricted shell and filesystem access.
PI_UNSAFE_FULL_ACCESS=false
# Browser requests to MCP transports are accepted only from SERVER_URL's own origin or these
# additional comma-separated exact http(s) origins. Wildcards, paths, credentials, and `null` are rejected.
CORS_ORIGINS=
