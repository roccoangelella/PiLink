{
  "name": "vspilink",
  "displayName": "VSPiLink — PiLink for VS Code",
  "description": "Start, connect, and manage the PiLink MCP bridge for the project open in VS Code.",
  "version": "2.2.0",
  "publisher": "0xfunboy",
  "license": "MIT",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "mcp",
    "pilink",
    "chatgpt",
    "oauth",
    "coding-agent"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/roccoangelella/PiLink.git"
  },
  "bugs": {
    "url": "https://github.com/roccoangelella/PiLink/issues"
  },
  "homepage": "https://github.com/roccoangelella/PiLink#readme",
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onStartupFinished",
    "onView:vspilink.sidebarSecondaryView"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In Restricted Mode, VSPiLink shows PiLink status and documentation while setup, OAuth, service start, and project access remain blocked.",
      "restrictedConfigurations": [
        "vspilink.configPath",
        "vspilink.nodeExecutable",
        "vspilink.nativeMcpScope"
      ]
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "vspilink.openSidebar",
        "title": "Open PiLink",
        "category": "VSPiLink",
        "icon": "$(layout-sidebar-right)"
      },
      {
        "command": "vspilink.openPanel",
        "title": "Open PiLink in Editor",
        "category": "VSPiLink",
        "icon": "$(open-preview)"
      },
      {
        "command": "vspilink.connectChatGpt",
        "title": "Connect ChatGPT",
        "category": "VSPiLink",
        "icon": "$(plug)"
      },
      {
        "command": "vspilink.stop",
        "title": "Stop PiLink",
        "category": "VSPiLink",
        "icon": "$(debug-stop)"
      },
      {
        "command": "vspilink.guidedSetup",
        "title": "Reconfigure PiLink (Advanced)",
        "category": "VSPiLink",
        "icon": "$(settings-gear)"
      },
      {
        "command": "vspilink.openConfig",
        "title": "Open PiLink Configuration",
        "category": "VSPiLink",
        "icon": "$(settings-gear)"
      },
      {
        "command": "vspilink.refresh",
        "title": "Refresh PiLink Status",
        "category": "VSPiLink",
        "icon": "$(refresh)"
      },
      {
        "command": "vspilink.useWorkspace",
        "title": "Use This Folder for PiLink",
        "category": "VSPiLink"
      },
      {
        "command": "vspilink.openDocs",
        "title": "Open PiLink Guide",
        "category": "VSPiLink",
        "icon": "$(book)"
      }
    ],
    "configuration": {
      "title": "VSPiLink",
      "properties": {
        "vspilink.openOnStartup": {
          "type": "boolean",
          "default": false,
          "description": "Open the optional PiLink sidebar after VS Code finishes starting."
        },
        "vspilink.configPath": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "restricted": true,
          "description": "Optional path to the PiLink .env file. Supports ~ and ${workspaceFolder}. When empty, the extension uses PILINK_CONFIG or ~/.config/pilink/.env."
        },
        "vspilink.nativeMcpScope": {
          "type": "string",
          "enum": [
            "mcp:read",
            "mcp:write",
            "mcp:tools"
          ],
          "enumDescriptions": [
            "Read-only access: list, search, and read.",
            "Mutation tools only; bash still follows the server access mode.",
            "All tools allowed by the server access mode."
          ],
          "default": "mcp:read",
          "scope": "application",
          "restricted": true,
          "description": "OAuth scope used by the optional native VS Code MCP provider."
        },
        "vspilink.nodeExecutable": {
          "type": "string",
          "default": "",
          "scope": "application",
          "restricted": true,
          "description": "Optional path to exactly Node.js 24.18.0 for the PiLink helper process. When empty, the extension first checks node on PATH and uses the extension-host runtime only when it has the exact same version."
        }
      }
    },
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "vspilinkSecondaryViewContainer",
          "title": "PiLink",
          "icon": "media/icon.png"
        }
      ]
    },
    "views": {
      "vspilinkSecondaryViewContainer": [
        {
          "id": "vspilink.sidebarSecondaryView",
          "type": "webview",
          "name": "PiLink"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "vspilink.openPanel",
          "when": "view == vspilink.sidebarSecondaryView",
          "group": "navigation@1"
        },
        {
          "command": "vspilink.refresh",
          "when": "view == vspilink.sidebarSecondaryView",
          "group": "navigation@2"
        },
        {
          "command": "vspilink.openConfig",
          "when": "view == vspilink.sidebarSecondaryView",
          "group": "navigation@3"
        }
      ],
      "explorer/context": [
        {
          "command": "vspilink.useWorkspace",
          "when": "resourceScheme == file",
          "group": "vspilink@1"
        }
      ]
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "vspilink.mcp",
        "label": "PiLink"
      }
    ]
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "typecheck": "../../node_modules/.bin/tsc -p tsconfig.json --noEmit",
    "test": "../../node_modules/.bin/tsx --test test/*.test.ts",
    "package": "node ./scripts/package.mjs"
  },
  "devDependencies": {}
}
