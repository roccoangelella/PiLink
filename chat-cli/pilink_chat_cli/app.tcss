/* ============================================================================
   PiLink chat — theme / design system (Textual 0.51)
   ----------------------------------------------------------------------------
   Dark glassmorphism port of the web frontend. Terminal limitations:

   * No @keyframes and no `animate:` CSS property — unsupported in 0.51
     (StylesBuilder has no `process_animate`; an `animate:` declaration raises
     DeclarationError). Motion is done in code via `widget.animate()`.
   * No `opacity:`, `font-family:`, `text-transform:`, `text-overflow:` in
     0.51 — mono / uppercase / ellipsis / glow are approximated with colors,
     max-width and bold text, or handled in code.
   * `transition:` IS supported in 0.51 and is used for hover smoothing.

   Every color is a hex literal matching the tokens in theme.py.
   ========================================================================== */

/* --- Widgets base -------------------------------------------------------- */

App {
    background: #0b0f19;
}

Screen {
    background: #0b0f19;
    color: #f8fafc;
}

/* --- App header ----------------------------------------------------------- */

.app-header {
    layout: horizontal;
    height: 3;
    padding: 0 1;
    background: #111827;
    border-bottom: solid #1e293b;
    align-vertical: middle;
}

.brand {
    layout: horizontal;
    height: auto;
    width: auto;
}

.brand-logo {
    /* web gradient approximated with solid cyan + dark text */
    background: #38bdf8;
    color: #0b0f19;
    text-style: bold;
    padding: 0 1;
    border: round #38bdf8;
}

.brand-title {
    color: #f8fafc;
    text-style: bold;
    padding: 0 1;
}

.subtitle {
    color: #8b9cb5;
    padding: 0 1;
}

/* --- Status pill / dot ---------------------------------------------------- */

.status-pill {
    layout: horizontal;
    height: auto;
    padding: 0 1;
    background: #1e293b;
    border: round #334155;
    color: #94a3b8;
}

.status-pill.error {
    border: round #f43f5e;
    color: #f43f5e;
    text-style: bold;
}

.status-dot {
    width: 1;
    height: 1;
    color: #334155;
    text-style: bold;
}

.status-dot.on {
    /* bright emerald; the web "glow" is approximated with bold bright text */
    color: #34d399;
    text-style: bold;
}

.status-dot.off {
    /* dim green while the pulse is "off" */
    color: #166534;
}

.status-dot.error {
    /* static rose error state */
    color: #f43f5e;
    text-style: bold;
}

/* Kanban column status dots */
.status-dot.working {
    color: #fbbf24;
}

.status-dot.completed {
    color: #34d399;
}

.status-dot.open {
    color: #38bdf8;
}

.status-dot.cancelled {
    color: #8b9cb5;
}

/* --- Nav tabs ------------------------------------------------------------- */

.nav-tabs {
    layout: horizontal;
    height: auto;
    padding: 0 1;
}

.nav-btn {
    background: transparent;
    border: none;
    color: #94a3b8;
    height: 3;
}

/* explicit widths: emoji cell widths differ between the headless
   compositor and a real terminal driver in 0.51, which can clip the
   last tab label in a PTY */
#tab-btn-chat {
    width: 20;
}

#tab-btn-tasks {
    width: 20;
}

#tab-btn-json {
    width: 14;
}

.nav-btn:hover {
    color: #f8fafc;
    background: #1e293b;
}

.nav-btn.active {
    background: #38bdf8;
    color: #0b0f19;
    text-style: bold;
}

.badge-count {
    background: #38bdf8;
    color: #0b0f19;
    text-style: bold;
    padding: 0 1;
    border: round #38bdf8;
}

/* --- Toolbar -------------------------------------------------------------- */

.toolbar {
    layout: horizontal;
    height: auto;
    padding: 0 1;
    background: #0b0f19;
    border-bottom: solid #1e293b;
}

/* Text widgets inside horizontal rows must be content-sized: Textual 0.51
   defaults them to 1fr, which stretches the first child across the whole
   row and pushes every sibling off-screen. */
.brand-logo,
.status-pill,
.nav-tabs,
.msg-meta,
.cursor-badge,
.msg-id,
.col-title,
.badge-count,
.drawer-code,
.drawer-status-badge,
.timeline-title,
#update-status {
    width: auto;
}

.col-title > Static {
    width: auto;
    height: 1;
}

.timeline-header {
    layout: horizontal;
    height: auto;
}

.timeline-header > Static {
    width: auto;
}

.timeline-title {
    /* titles were inheriting the dim timeline-content color */
    color: #f8fafc;
    text-style: bold;
}

.search-box {
    border: round #334155;
    background: #111827;
    color: #f8fafc;
    width: 36;
}

.search-box:focus {
    border: round #38bdf8;
}

.role-chip {
    background: #111827;
    border: round #334155;
    color: #94a3b8;
    padding: 0 1;
    transition: background 0.2s in_out_cubic 0s, border 0.2s in_out_cubic 0s;
}

.role-chip.active {
    border: round #38bdf8;
    color: #38bdf8;
    text-style: bold;
}

.role-chip:hover {
    background: #334155;
    border: round #38bdf8;
}

/* --- Message cards -------------------------------------------------------- */

.message-card {
    height: auto;
    background: #1e293b;
    border: round #334155;
    padding: 1 2;
    margin: 0 1 1 1;
}

.message-card.new {
    /* brighter border during entrance (used with widget.animate() in code) */
    border: round #38bdf8;
}

.msg-header {
    layout: horizontal;
    height: auto;
}

.avatar {
    width: 3;
    height: 1;
    border: round #38bdf8;
    color: #38bdf8;
    text-align: center;
    text-style: bold;
}

.author-name {
    color: #f8fafc;
    text-style: bold;
    padding: 0 1;
}

.role-tag {
    /* uppercase is applied in code (no text-transform in 0.51) */
    color: #38bdf8;
    text-style: bold;
    padding: 0 1;
}

.msg-meta {
    layout: horizontal;
    height: auto;
    color: #8b9cb5;
    padding: 0 1;
}

.cursor-badge {
    /* mono is the terminal default; cyan bold badge */
    color: #38bdf8;
    text-style: bold;
    padding: 0 1;
}

.msg-body {
    color: #f8fafc;
    padding: 0 0 0 1;
}

.task-chip {
    background: #0b0f19;
    border: round #38bdf8;
    color: #38bdf8;
    padding: 0 1;
    transition: background 0.2s in_out_cubic 0s, border 0.2s in_out_cubic 0s;
}

.task-chip.working {
    border: round #fbbf24;
    color: #fbbf24;
}

.task-chip.completed {
    border: round #34d399;
    color: #34d399;
}

.task-chip.open {
    border: round #38bdf8;
    color: #38bdf8;
}

.task-chip:hover {
    background: #334155;
}

/* --- Kanban --------------------------------------------------------------- */

.kanban-grid {
    layout: horizontal;
    height: 1fr;
    padding: 0 1;
}

.kanban-col {
    width: 1fr;
    height: 1fr;
    padding: 0 1;
}

.col-header {
    layout: horizontal;
    height: auto;
    padding: 0 1;
    background: #111827;
    border: round #1e293b;
}

.col-title {
    height: 1;
    color: #f8fafc;
    text-style: bold;
}

.task-card {
    background: #1e293b;
    border: round #334155;
    padding: 1;
    margin: 0 0 1 0;
    transition: background 0.2s in_out_cubic 0s, border 0.2s in_out_cubic 0s;
}

.task-card:hover {
    /* hover "lift": brighter surface + cyan border */
    background: #334155;
    border: round #38bdf8;
}

.task-id-tag {
    color: #38bdf8;
    text-style: bold;
}

.task-card-title {
    color: #f8fafc;
    text-style: bold;
}

.task-card-desc {
    /* dim; 2-line clamp / ellipsis unavailable in 0.51 -> dim + max-width,
       truncation handled in code */
    color: #8b9cb5;
    max-width: 100%;
}

.task-card-footer {
    layout: horizontal;
    height: auto;
    color: #8b9cb5;
}

.empty-col {
    border: dashed #334155;
    color: #8b9cb5;
    padding: 1;
    text-align: center;
}

/* --- Drawer / details ----------------------------------------------------- */

.drawer-panel {
    dock: right;
    width: 48;
    height: 1fr;
    background: #111827;
    border-left: solid #0e7490; /* cyan-tinted */
    padding: 1;
}

.drawer-header {
    layout: horizontal;
    height: auto;
}

.drawer-title {
    color: #f8fafc;
    text-style: bold;
}

.drawer-subtitle {
    layout: horizontal;
    height: auto;
    color: #8b9cb5;
}

.drawer-close {
    background: #1e293b;
    border: round #334155;
    color: #94a3b8;
    height: 3;
}

.drawer-close:hover {
    background: #334155;
    color: #f8fafc;
}

.section-box {
    background: #1e293b;
    border: round #334155;
    padding: 1;
    margin: 1 0;
}

.meta-grid {
    layout: grid;
    grid-size: 2;
    grid-gutter: 1;
}

.meta-label {
    color: #8b9cb5;
}

.meta-val {
    color: #f8fafc;
}

.timeline {
    layout: vertical;
    height: auto;
}

.timeline-item {
    layout: horizontal;
    height: auto;
}

.timeline-icon {
    width: 1;
    color: #38bdf8;
    text-style: bold;
}

.timeline-content {
    color: #94a3b8;
    padding: 0 1;
}

.json-view {
    /* mono is the terminal default; dim code block */
    color: #8b9cb5;
    background: #0b0f19;
    border: round #1e293b;
    padding: 1;
}

.empty-state {
    border: dashed #334155;
    color: #8b9cb5;
    padding: 1 2;
    text-align: center;
}

.footer-hints {
    color: #8b9cb5;
    padding: 0 1;
    text-align: center;
}

/* --- Button overrides (palette-matched) ----------------------------------- */

Button {
    background: #1e293b;
    color: #f8fafc;
    border: round #334155;
    transition: background 0.2s in_out_cubic 0s, border 0.2s in_out_cubic 0s;
}

Button:hover {
    background: #334155;
}

Button:focus {
    border: round #38bdf8;
}
