{
  "name": "pilink",
  "version": "1.1.0",
  "description": "Hardened OAuth-protected MCP server for the Pi Agent tool harness",
  "main": "dist/index.js",
  "bin": {
    "pilink": "dist/cli.js"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/roccoangelella/PiLink.git"
  },
  "bugs": {
    "url": "https://github.com/roccoangelella/PiLink/issues"
  },
  "homepage": "https://github.com/roccoangelella/PiLink#readme",
  "keywords": [
    "pilink",
    "mcp",
    "model-context-protocol",
    "pi-agent",
    "coding-agent",
    "oauth"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "npm run build && node --test test/**/*.test.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@achingbrain/nat-port-mapper": "^4.0.5",
    "@earendil-works/pi-coding-agent": "^0.82.1",
    "@modelcontextprotocol/sdk": "^1.1.0",
    "bcryptjs": "^2.4.3",
    "default-gateway": "^7.2.2",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "uuid": "^11.0.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/default-gateway": "^7.2.2",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
